							<PackageName><![CDATA[com.anylogic.libraries.pedestrian]]></PackageName>
							<ClassName><![CDATA[PedSink]]></ClassName>
							<ItemName><![CDATA[1412464601104]]></ItemName>
						</GenericParameterSubstituteReference>
					</GenericParameterSubstitute>
					<Parameters>
						<Parameter>
							<Name><![CDATA[onEnter]]></Name>
							<Value Class="CodeValue">
								<Code><![CDATA[Traveller t = (Traveller) ped;
// Only start recording statistics AFTER 15 minutes have passed
if (time() >= 15.0) {
    if (t.totalSimulatedTime > 0) {
        double individualRatio = (t.stationaryTime / t.totalSimulatedTime) * 100.0;

        if (t.isLocal && t.hasBaggage) {
            sum_Local_Baggage += individualRatio;
            count_Local_Baggage++;
            avg_Local_Baggage = sum_Local_Baggage / count_Local_Baggage;
            
        } else if (t.isLocal && !t.hasBaggage) {
            sum_Local_NoBaggage += individualRatio;
            count_Local_NoBaggage++;
            avg_Local_NoBaggage = sum_Local_NoBaggage / count_Local_NoBaggage;
            
        } else if (!t.isLocal && t.hasBaggage) {
            sum_Foreign_Baggage += individualRatio;
            count_Foreign_Baggage++;
            avg_Foreign_Baggage = sum_Foreign_Baggage / count_Foreign_Baggage;
            
        } else if (!t.isLocal && !t.hasBaggage) {
            sum_Foreign_NoBaggage += individualRatio;
            count_Foreign_NoBaggage++;
            avg_Foreign_NoBaggage = sum_Foreign_NoBaggage / count_Foreign_NoBaggage;
        }
    }
}]]></Code>
							</Value>
						</Parameter>
					</Parameters>
					<ReplicationFlag>false</ReplicationFlag>
					<Replication Class="CodeValue">
						<Code><![CDATA[100]]></Code>
					</Replication>
